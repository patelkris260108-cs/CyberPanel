# CyberGuard environment variables
# Copy this file to .env and fill in your values.

# --- Required for AI features in CyberGuard ---
# Get your free API key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- Optional overrides ---
# NVIDIA NIM base URL (default: NVIDIA's hosted endpoint)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model to use (any NVIDIA NIM-hosted model)
# CYBERSEC_MODEL=meta/llama-3.1-70b-instruct

# Maximum tokens per LLM response
# CYBERSEC_MAX_TOKENS=1024
